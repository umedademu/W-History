{
  "islam-origin": "<a class=\"story-card\" href=\"/islam-origin-story.html\">\n          <div class=\"cover cover-islam-origin\">\n            <span class=\"cover-number\">01</span>\n            <span class=\"cover-place\">MECCA / MEDINA</span>\n            <img src=\"/images/islam-origin/kaaba-sanctuary.png\" alt=\"\" width=\"192\" height=\"192\" />\n            <span class=\"cover-caption\">砂漠の隊商路から、信徒共同体へ。</span>\n          </div>\n          <div class=\"card-body\">\n            <p class=\"lesson-part\">第20回・1</p>\n            <p class=\"period\">6世紀末〜661年 <span>22ページ</span></p>\n            <h3>イスラーム教の成立〜正統カリフ時代</h3>\n            <p>隊商都市メッカの繁栄、ムハンマドの啓示とヒジュラ、ウンマ結成から四代の正統カリフによる領土拡大と内乱までをたどります。</p>\n            <span class=\"card-action\">物語を開く <span aria-hidden=\"true\">↗</span></span>\n          </div>\n        </a>",
  "umayyad-abbasid": "<a class=\"story-card\" href=\"/umayyad-abbasid-story.html\">\n          <div class=\"cover cover-umayyad-abbasid\">\n            <span class=\"cover-number\">02</span>\n            <span class=\"cover-place\">DAMASCUS / BAGHDAD</span>\n            <img src=\"/images/umayyad-abbasid/baghdad-round-city.png\" alt=\"\" width=\"192\" height=\"192\" />\n            <span class=\"cover-caption\">血統の支配から、全信徒の普遍帝国へ。</span>\n          </div>\n          <div class=\"card-body\">\n            <p class=\"lesson-part\">第20回・2</p>\n            <p class=\"period\">661〜1258年 <span>19ページ</span></p>\n            <h3>ウマイヤ朝とアッバース朝</h3>\n            <p>ダマスクスのアラブ帝国から、アッバース革命による平等のイスラーム帝国化、円形都市バグダードの繁栄と知恵の館までをつなぎます。</p>\n            <span class=\"card-action\">物語を開く <span aria-hidden=\"true\">↗</span></span>\n          </div>\n        </a>",
